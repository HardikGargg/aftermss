# Copy to .env. Not required for `python -m aftermess demo`.
# Required for `python -m aftermess run` (Strands) and live WhatsApp.

# Option A — Amazon Bedrock (hackathon default)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Option B — skip AWS for local iteration
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# WhatsApp. simulator is the default (outbox JSON only).
# WHATSAPP_PROVIDER=simulator
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# OPEN overlays (leave unset rather than inventing campus clocks)
# AFTERMESS_TRIP_RUPEES=
# AFTERMESS_USE_BY_HOURS=
# AFTERMESS_LANGUAGE=
# AFTERMESS_LUNCH_NEED_CUTOFF=
# AFTERMESS_LUNCH_END=
# AFTERMESS_DINNER_NEED_CUTOFF=
# AFTERMESS_DINNER_END=
# AFTERMESS_TIMEOUT_MESS_RELEASE=
# AFTERMESS_TIMEOUT_RIDER_ACCEPT=

# Live deploy (S3 keeps sitting state across container restarts)
# AFTERMESS_S3_BUCKET=
# AFTERMESS_S3_PREFIX=aftermess
# Optional token for POST /demo (leave empty for the public judge page)
# AFTERMESS_DEMO_TOKEN=
