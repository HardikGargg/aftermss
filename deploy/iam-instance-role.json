{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockNova",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SittingState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::aftermess-*",
        "arn:aws:s3:::aftermess-*/*"
      ]
    }
  ]
}
