{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HostTheWebhook",
      "Effect": "Allow",
      "Action": [
        "apprunner:*",
        "ecr:*",
        "s3:*",
        "logs:*",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:CreateRole",
        "iam:TagRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:PutRolePolicy",
        "iam:CreateServiceLinkedRole",
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*"
    }
  ]
}
